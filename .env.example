# --- Food-search proxy credentials (set on the Netlify site) ---------------
# Site settings -> Environment variables. The food-search function reads these
# at runtime. Any that are missing simply cause that source to be skipped.

# USDA FoodData Central (fresh produce + whole/generic foods). Instant + free:
#   https://fdc.nal.usda.gov/api-key-signup/
USDA_API_KEY=

# FatSecret (branded + restaurant meals). Use the "Premier Free" tier so you can
# whitelist 0.0.0.0/0 (any IP), which is required for Netlify's serverless IPs:
#   https://platform.fatsecret.com/  (register, then Manage API Keys)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Anthropic (the "eat out" meal-recommendation chatbot / meal-advisor function).
# Metered, but pennies per question. Create a key + add a small credit balance:
#   https://console.anthropic.com/  (API keys)
ANTHROPIC_API_KEY=

# --- Client (native app / local dev only) ----------------------------------
# Absolute base URL the app uses to reach the proxy. Leave BLANK for the
# deployed web build (same origin). For Expo Go / native, set it to the hosted
# site (https://your-site.netlify.app) or a `netlify dev` LAN URL
# (e.g. http://192.168.1.161:8888).
EXPO_PUBLIC_FOOD_API_BASE=
